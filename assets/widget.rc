// Windows resources for cna-widget.exe: application icon + the version info shown in Explorer > Properties.
// version_info.h is generated by the build from the VERSION file.
#include "version_info.h"

1 ICON "cna.ico"

1 VERSIONINFO
 FILEVERSION CNA_VER_COMMA
 PRODUCTVERSION CNA_VER_COMMA
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "ProductName", "Clean-n-Adapt"
      VALUE "FileDescription", "Clean-n-Adapt widget"
      VALUE "FileVersion", CNA_VER_STR
      VALUE "ProductVersion", CNA_VER_STR
      VALUE "OriginalFilename", "cna-widget.exe"
      VALUE "InternalName", "widget"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
